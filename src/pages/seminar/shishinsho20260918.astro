---
const title = '第１回指針書ワーク振り返り会';
const organizer = '一般社団法人 東京中小企業家同友会';
const copyrightHolders = [
  '一般社団法人 東京中小企業家同友会',
  '合同会社アクララール',
  '株式会社ユーアンドエム',
  '株式会社ユニオンクラフト',
];
const deadline = '2026年9月30日';
const deadlineISO = '2026-10-01T01:59:00+09:00';
const videoUrl = 'https://customer-muxtdmy486fmsk10.cloudflarestream.com/225f90d50272c3d68cfdfd149ffba6bf/watch';
const surveyUrl = 'https://forms.gle/xoZD8bbUr6mfH1rU6';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <main class="card">
        <p class="organizer">主催：{organizer}</p>
        <h1>{title}</h1>
        <p class="deadline">視聴期限：{deadline}まで</p>

        <div id="video-area">
          <div class="video-wrap" data-deadline={deadlineISO}>
            <iframe
              src={videoUrl}
              loading="lazy"
              style="border:none;position:absolute;top:0;left:0;height:100%;width:100%;"
              allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
              allowfullscreen>
            </iframe>
          </div>
          <p class="expired-message" hidden>この動画の視聴期限は{deadline}をもって終了しました。</p>
        </div>

        <div class="survey-box">
          <p>動画をご視聴いただいた後、下記のアンケートへのご回答にご協力ください。</p>
          <a href={surveyUrl} class="survey-btn" target="_blank" rel="noopener">アンケートに回答する</a>
        </div>

        <p class="note">
          本ページはお申込みいただいた方限定でご案内しております。URLの共有はご遠慮くださいますようお願いいたします。
        </p>
      </main>

      <footer class="page-footer">
        <p class="copyright-label">&copy; {new Date().getFullYear()}</p>
        <ul class="copyright-list">
          {copyrightHolders.map((holder) => <li>{holder}</li>)}
        </ul>
        <p class="distribution-credit">配信協力：むすびかなでる</p>
      </footer>
    </div>

    <script define:vars={{ deadlineISO }}>
      const wrap = document.querySelector('.video-wrap');
      const expiredMsg = document.querySelector('.expired-message');
      if (wrap && new Date() > new Date(deadlineISO)) {
        wrap.hidden = true;
        if (expiredMsg) expiredMsg.hidden = false;
      }
    </script>

    <style>
      :root {
        --color-brand-primary: #1A6B68;
        --color-brand-primary-dark: #0F4D4B;
        --color-brand-accent: #79B31B;
        --color-text-main: #2A2A35;
        --color-text-sub: #4A4A5A;
        --color-bg-body: #FAFAF8;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 17px; }
      body {
        font-family: "Noto Sans JP", "Hiragino Sans", "Yu Gothic", "Meiryo", sans-serif;
        color: var(--color-text-main);
        background: var(--color-bg-body);
        line-height: 1.85;
        letter-spacing: 0.03em;
        min-height: 100vh;
      }
      .page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.25rem;
      }
      .card {
        width: 100%;
        max-width: 760px;
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        padding: 2.5rem 2rem;
      }
      .organizer {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text-sub);
        margin-bottom: 0.6rem;
      }
      h1 {
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1.5;
        margin-bottom: 0.8rem;
      }
      .deadline {
        display: inline-block;
        font-size: 0.85rem;
        font-weight: 700;
        color: #fff;
        background: var(--color-brand-primary);
        padding: 0.3rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1.75rem;
      }
      .video-wrap {
        position: relative;
        width: 100%;
        padding-top: 56.25%;
        background: #000;
        border-radius: 8px;
        overflow: hidden;
      }
      .expired-message {
        background: var(--color-bg-body);
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 8px;
        padding: 3rem 1.5rem;
        text-align: center;
        color: var(--color-text-sub);
        font-size: 0.95rem;
      }
      .survey-box {
        margin-top: 1.75rem;
        background: var(--color-bg-body);
        border: 1px solid rgba(0,0,0,0.08);
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
      }
      .survey-box p {
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }
      .survey-btn {
        display: inline-block;
        background: var(--color-brand-primary);
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        text-decoration: none;
        padding: 0.65rem 1.8rem;
        border-radius: 6px;
        transition: background 0.2s;
      }
      .survey-btn:hover {
        background: var(--color-brand-primary-dark);
      }
      .note {
        margin-top: 1.75rem;
        font-size: 0.82rem;
        color: var(--color-text-sub);
        line-height: 1.8;
      }
      .page-footer {
        margin-top: 2.5rem;
        text-align: center;
        font-size: 0.78rem;
        color: var(--color-text-sub);
        opacity: 0.7;
      }
      .copyright-label {
        margin-bottom: 0.2rem;
      }
      .copyright-list {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0 0.6rem;
      }
      .copyright-list li:not(:last-child)::after {
        content: '・';
      }
      .distribution-credit {
        margin-top: 0.5rem;
        font-size: 0.72rem;
        opacity: 0.8;
      }
      @media (max-width: 560px) {
        .card { padding: 1.75rem 1.25rem; }
        h1 { font-size: 1.3rem; }
      }
    </style>
  </body>
</html>
